  },
  "semantic": {
    "color.text.primary": "#1D1D1F",
    "color.text.secondary": "#6E6E73",
    "color.text.inverse": "#F5F5F7",
    "color.action.primary": "#F4511E",
    "color.action.primaryText": "#1D1D1F",
    "color.action.text": "#1D1D1F",
    "color.border.subtle": "#D9D9DE",
    "color.focus.ring": "#F4511E",
    "surface.canvas": "#F5F5F7",
    "surface.elevated": "#FFFFFF",
    "surface.inverse": "#1D1D1F"
  },
  "modes": {
