      "semantic": {
        "color.text.primary": "#F5F5F7",
        "color.text.secondary": "#A1A1A6",
        "color.text.inverse": "#1D1D1F",
        "color.action.primary": "#F4511E",
        "color.action.primaryText": "#1D1D1F",
        "color.action.text": "#F5F5F7",
        "color.border.subtle": "#38383A",
        "color.focus.ring": "#F4511E",
